      "name": "Persistir Memoria",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1860, 0]
    },
    {
      "parameters": {
        "sendTo": "paivaignacio09@gmail.com",
        "subject": "=[MEMORIA M3] Ejecucion {{ $execution.id }} - Sesion {{ $('Consolidar Memoria').first().json.session_id }}",
        "emailType": "text",
        "message": "=LOG DE TRAZABILIDAD Y MEMORIA PERSISTENTE\n\nID de ejecucion: {{ $execution.id }}\nFecha y hora: {{ $now.format('dd/MM/yyyy HH:mm:ss') }}\nSession ID: {{ $('Consolidar Memoria').first().json.session_id }}\n\n--- 1. CAPA DE MEMORIA (LECTURA) ---\nUsuario nuevo: {{ $('Contexto Sesion Nueva').isExecuted ? 'SI - se creo registro inicial en Airtable' : 'NO - se recupero memoria existente' }}\nIntercambio numero: {{ $('Consolidar Memoria').first().json.contador_mensajes }}\nContexto inyectado al agente:\n{{ $('Router de Triaje').first().json.contexto_memoria }}\n\n--- 2. CONSULTA ORIGINAL ---\n{{ $('Consolidar Memoria').first().json.chat_input }}\n\n--- 3. WORKERS INVOCADOS ---\nWorker 1 (datos): {{ $('Ejecutar Worker Datos').isExecuted ? 'INVOCADO' : 'no invocado' }}\nWorker 2 (redaccion): {{ $('Ejecutar Worker Redaccion').isExecuted ? 'INVOCADO' : 'no invocado' }}\nEscalamiento humano: {{ $('Via de Escape - Supervisor Humano').isExecuted ? 'SI' : 'no' }}\n\n--- 4. RESPUESTA AL CLIENTE ---\n{{ $('Consolidar Memoria').first().json.respuesta_cliente }}\n\n--- 5. CAPA DE MEMORIA (ESCRITURA) ---\nSummarization disparada: {{ $('Summarizer').isExecuted ? 'SI - supero los 5 intercambios' : 'NO - se mantiene el resumen previo' }}\nResumen consolidado persistido: {{ $('Persistir Memoria').first().json.Resumen_Consolidado }}\nEstado del caso: {{ $('Consolidar Memoria').first().json.estado_caso }}\nDatos clave: {{ $('Consolidar Memoria').first().json.datos_clave }}\n\n--- FIN DEL LOG ---",
        "options": { "appendAttribution": false }
      },
      "id": "b3000000-0000-4000-8000-000000000022",
      "name": "Log de Trazabilidad",
      "type": "n8n-nodes-base.gmail",
